# ==========================================
# 智面舱 (AI Interview Hub) 环境变量配置示例
# ==========================================

# 运行环境: development | production | test
ENVIRONMENT=development

# 数据库配置 (本地快速开发默认使用 SQLite，生产环境推荐 MySQL 8)
# SQLite 本地零依赖:
DATABASE_URL=sqlite:///./zhimeicang.db
# 生产 MySQL 示例:
# DATABASE_URL=mysql+pymysql://zhimeicang:replace-with-a-strong-password@127.0.0.1:3306/zhimeicang?charset=utf8mb4

# Docker Compose 的 MySQL 配置
MYSQL_DATABASE=zhimeicang
MYSQL_USER=zhimeicang
MYSQL_PASSWORD=replace-with-a-strong-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-password

# Redis 缓存与限流 (可选，未配置时自动降级为进程内内存缓存)
REDIS_URL=redis://127.0.0.1:6379/0

# JWT 鉴权密钥 (生产环境请务必修改为强随机字符串)
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI 引擎调度模式:
# MOCK: 内置确定性沙箱引擎，无需外部 Key，开箱即用，支持六维雷达图与评测诊断
# REAL: 真实大语言模型，需配置以下 LLM 参数；未配置 Key 或调用失败时自动回退 MOCK
AI_MODE=REAL

# 大语言模型配置 (当 AI_MODE=REAL 时生效，兼容 OpenAI 标准协议)
# 提示: 也可留空不填，部署后在登录页「AI 引擎配置」向导 (/ai-setup) 中在线配置，
#       页面配置保存在数据库中，优先级高于本文件，保存即时生效无需重启。
# 示例：阿里通义千问 DashScope 的 OpenAI 兼容端点
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 示例：DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.7

# 文件上传与存储路径
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=20
